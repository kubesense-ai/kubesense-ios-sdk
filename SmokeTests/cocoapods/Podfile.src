abstract_target 'Common' do
  pod 'OpenTelemetry-Swift-Api', '2.5.0'
  pod 'KubesenseInternal', :git => 'https://github.com/kubesense-ai/kubesense-ios-sdk.git', :GIT_REFERENCE
  pod 'KubesenseCore', :git => 'https://github.com/kubesense-ai/kubesense-ios-sdk.git', :GIT_REFERENCE
  pod 'KubesenseLogs', :git => 'https://github.com/kubesense-ai/kubesense-ios-sdk.git', :GIT_REFERENCE
  pod 'KubesenseTrace', :git => 'https://github.com/kubesense-ai/kubesense-ios-sdk.git', :GIT_REFERENCE
  pod 'KubesenseRUM', :git => 'https://github.com/kubesense-ai/kubesense-ios-sdk.git', :GIT_REFERENCE
  pod 'KubesenseCore', :git => 'https://github.com/kubesense-ai/kubesense-ios-sdk.git', :GIT_REFERENCE
  pod 'KubesenseSessionReplay', :git => 'https://github.com/kubesense-ai/kubesense-ios-sdk.git', :GIT_REFERENCE
  pod 'KubesenseCrashReporting', :git => 'https://github.com/kubesense-ai/kubesense-ios-sdk.git', :GIT_REFERENCE
  pod 'KubesenseFlags', :git => 'https://github.com/kubesense-ai/kubesense-ios-sdk.git', :GIT_REFERENCE
  pod 'KubesenseProfiling', :git => 'https://github.com/kubesense-ai/kubesense-ios-sdk.git', :GIT_REFERENCE

  target 'App Dynamic iOS' do
    platform :ios, '15.0'
    use_frameworks!
    pod 'KubesenseWebViewTracking', :git => 'https://github.com/kubesense-ai/kubesense-ios-sdk.git', :GIT_REFERENCE

    target 'App Dynamic iOS Tests' do
      inherit! :search_paths
    end
  end

  target 'App Static iOS' do
    platform :ios, '15.0'
    pod 'KubesenseWebViewTracking', :git => 'https://github.com/kubesense-ai/kubesense-ios-sdk.git', :GIT_REFERENCE

    target 'App Static iOS Tests' do
      inherit! :search_paths
    end
  end

  target 'App Dynamic tvOS' do
    platform :tvos, '15.0'
    use_frameworks!

    target 'App Dynamic tvOS Tests' do
      inherit! :search_paths
    end
  end

  target 'App Static tvOS' do
    platform :tvos, '15.0'

    target 'App Static tvOS Tests' do
      inherit! :search_paths
    end
  end

end
