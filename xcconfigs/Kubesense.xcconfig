// Include base config
#include "Base.xcconfig"

DEVELOPMENT_TEAM[sdk=iphoneos*]=// use your own Development Team

// Kubesense secrets for running Example app (manual tests, integration tests, benchmarks)
RUM_APPLICATION_ID=// use your own RUM Application ID obtained on kubesense.ai
KUBESENSE_CLIENT_TOKEN=// use your own Client Token, generated for RUM_APPLICATION_ID

// The Example app sends every feature to the collector host in CUSTOM_RUM_URL (`kubesenseRumEndpoint`):
// https://<host>/rum/api/v1/... The Kubesense SDK has no per-feature endpoints, so it does not read
// CUSTOM_LOGS_URL and CUSTOM_TRACE_URL.
CUSTOM_LOGS_URL=// Do NOT add https! example: foo.com/rum/api/v1/logs
CUSTOM_TRACE_URL=// Do NOT add https! example: foo.com/rum/api/v1/spans
CUSTOM_RUM_URL=// Do NOT add https! example: foo.com

// Overwrite with secrets
#include? "Kubesense.local.xcconfig"
