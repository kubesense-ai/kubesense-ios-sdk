module KubesenseMachProfiler {
  header "kubesense_profiler.h"
  header "kubesense_pprof.h"
  export *

  explicit module Cxx {
      requires cplusplus
      header "mach_sampling_profiler.h"
      header "profile.h"
      header "profile_pprof_packer.h"
      export *
  }

  explicit module Pprof {
      header "profile.pb-c.h"
      export *
  }

  explicit module Testing {
      header "binary_image_resolver_testing.h"
      header "kubesense_profiler_testing.h"
      header "kubesense_pprof_testing.h"
      header "safe_read_testing.h"
      export *
  }
}
